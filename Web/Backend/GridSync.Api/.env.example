# Copy to .env and fill in real values. Do not commit .env
MongoDbSettings__ConnectionString=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MongoDbSettings__DatabaseName=GridSync
JwtSettings__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JwtSettings__Issuer=GridSync.Api
JwtSettings__Audience=GridSync.Clients
JwtSettings__ExpiryMinutes=60
